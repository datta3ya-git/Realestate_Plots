        <section class="container my-5">

            <!-- Main heading -->
            <div class="text-center mb-4">
                <h2>About Plotz — What we solve & why it matters</h2>
                <p class="lead text-muted mx-auto" style="max-width:900px">
                    The traditional land-buying process is slow, opaque and travel-heavy. Plotz brings transparency,
                    trust and convenience
                    to land discovery — all from your phone.
                </p>
