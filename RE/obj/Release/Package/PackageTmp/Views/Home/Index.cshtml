    <style>
        /* -------------------------
       Custom design tokens (over Bootstrap)
       ------------------------- */
        :root {
            --accent: #06b6d4;
            /* primary accent */
            --muted: #6b7280;
            /* secondary text */
            --radius: 12px;
            --maxw: 1100px;
            font-family: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;
        }

        /* Global page background switched to white as requested */
        body {
            background: #ffffff;
            color: #0b1220
        }

        a {
            color: var(--accent)
        }

        /* Constrain content width similar to before */
        .container {
            max-width: var(--maxw)
        }

        /* Card visual which complements Bootstrap cards */
        .app-card {
            border-radius: var(--radius);
            box-shadow: 0 6px 18px rgba(2, 6, 23, 0.06);
            padding: 20px;
            background: #fff
        }

        /* Hero left column text spacing */
        .hero-title {
            font-size: 30px;
            font-weight: 700;
            margin-bottom: 8px
        }

        .muted {
            color: var(--muted)
        }

        /* Booking form small tweaks */
        .booking .form-control {
            border-radius: 10px
        }

        .btn-accent {
            background: linear-gradient(90deg, var(--accent), #7c3aed);
            color: #fff;
            border: 0
        }

        /* Footer */
        footer {
            border-top: 1px solid #eef2f7;
            padding: 20px 0;
            margin-top: 24px;
            color: var(--muted)
        }

        /* Small responsive adjustments */
        @*@media (max-width:900px) {
            .hero-title {
                font-size: 22px
            }
        }*@

        /* Make carousel images responsive and rounded */
        .carousel-img {
            width: 100%;
            height: 280px;
            object-fit: cover;
            border-radius: 12px
        }

        /* Small helpers for legal text when shown inside webview */
        .legal {
            max-height: 70vh;
            overflow: auto;
            padding-right: 8px
        }

        /* Accessibility: focus outlines for keyboard users */
        a:focus,
        button:focus,
        input:focus {
            outline: 3px solid rgba(6, 182, 212, 0.18);
            outline-offset: 2px
        }
    </style>

