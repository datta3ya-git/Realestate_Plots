{
	"info": {
		"_postman_id": "re-api-collection-001",
		"name": "RE API",
		"description": "Real Estate API - All endpoints with test scripts. Uses x-api-key header. Set base_url and api_key in environment.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "apikey",
		"apikey": [
			{ "key": "key", "value": "x-api-key", "type": "string" },
			{ "key": "value", "value": "{{api_key}}", "type": "string" },
			{ "key": "in", "value": "header", "type": "string" }
		]
	},
	"variable": [
		{ "key": "base_url", "value": "http://localhost:port" },
		{ "key": "api_key", "value": "your-api-key" }
	],
	"event": [
		{
			"listen": "prerequest",
			"script": { "exec": [""], "type": "text/javascript" }
		},
		{
			"listen": "test",
			"script": {
				"exec": [
					"// Common tests for all RE API requests",
					"pm.test('Status code is present', function() {",
					"    pm.expect(pm.response.code).to.be.a('number');",
					"});",
					"pm.test('Status code is 2xx or 204 or 500', function() {",
					"    var code = pm.response.code;",
					"    pm.expect([200, 201, 202, 204, 500]).to.include(code);",
					"});",
					"if (pm.response.code >= 200 && pm.response.code < 300 && pm.response.text()) {",
					"    try {",
					"        var json = pm.response.json();",
					"        if (json && json.hasOwnProperty('StatusCode')) {",
					"            pm.test('Response has StatusCode', function() { pm.expect(json.StatusCode).to.be.a('number'); });",
					"            pm.test('Response has Message', function() { pm.expect(json).to.have.property('Message'); });",
					"        }",
					"    } catch (e) {}",
					"}"
				],
				"type": "text/javascript"
			}
		}
	],
