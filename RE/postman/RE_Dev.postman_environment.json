{
	"id": "re-dev-env",
	"name": "RE - Dev",
	"values": [
		{
			"key": "base_url",
			"value": "https://dev-api.yourdomain.com",
			"type": "default",
			"enabled": true
		},
		{
			"key": "api_key",
			"value": "your-dev-api-key",
